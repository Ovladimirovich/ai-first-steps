{
  "name": "ai-first-steps",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio src/index.ts --port 3000",
    "render": "remotion render src/index.ts Main ../release/final.mp4 --codec h264 --crf 18",
    "render:nosubs": "remotion render src/index.ts Main ../release/final_nosubs.mp4 --props='{\"subs\":false}' --codec h264 --crf 18",
    "still": "remotion still src/index.ts Main ../storyboard/frame.png --frame"
  },
  "dependencies": {
    "@remotion/cli": "4.0.300",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.300"
  },
  "devDependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
