# Скопируйте этот файл в .env и заполните локально.
# Не присылайте секреты в чат и не коммитьте .env.
GIGACHAT_CLIENT_ID=
GIGACHAT_CLIENT_SECRET=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Необязательно: путь к доверенному CA-файлу, если проверка TLS требует его.
# GIGACHAT_CA_BUNDLE=C:\certs\sber-ca.pem

# AgnesImage через локальный ComfyUI. По умолчанию выключен.
# Для аккаунта, настроенного на бесплатную суточную квоту без платного fallback,
# раскомментируйте оба параметра. Runtime принимает только billing mode free_quota.
# AGNES_IMAGE_BILLING_MODE=free_quota
# AGNES_IMAGE_RUNTIME_ENABLED=true

# Необязательная локальная озвучка Piper; без этих параметров остаётся демо-тишина.
# Также можно настроить в интерфейсе «Замысел» → «Озвучка · Piper».
# FACTORY_VOICE_PROVIDER=piper
# PIPER_EXECUTABLE=C:\\Tools\\Piper\\piper.exe
# PIPER_MODEL_H1=C:\\Models\\ru_RU-dmitri-medium.onnx
# PIPER_MODEL_H2=C:\\Models\\ru_RU-irina-medium.onnx
